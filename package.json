{
	"name": "social-share-toolkit",
	"version": "1.1.0",
	"description": "Social Share Toolkit is a versatile library for sharing content across various social media platforms, designed to work seamlessly with both React and Vue applications.",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react/index.d.mts",
				"default": "./dist/react/index.mjs"
			},
			"require": {
				"types": "./dist/react/index.d.ts",
				"default": "./dist/react/index.js"
			}
		},
		"./vue": {
			"import": {
				"types": "./dist/vue/index.d.mts",
				"default": "./dist/vue/index.mjs"
			},
			"require": {
				"types": "./dist/vue/index.d.ts",
				"default": "./dist/vue/index.js"
			}
		}
	},
	"typesVersions": {
		"*": {
			"react": [
				"./dist/react/index.d.ts"
			],
			"vue": [
				"./dist/vue/index.d.ts"
			]
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"format": "prettier --write \"{src,tests}/**/*.{ts,tsx,vue}\"",
		"format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,vue}\"",
		"lint": "eslint src tests",
		"lint:fix": "eslint src tests --fix",
		"prepare": "husky",
		"prepublishOnly": "npm run build",
		"test": "vitest run",
		"commitlint": "commitlint --edit",
		"test:watch": "vitest",
		"typecheck": "vue-tsc --noEmit",
		"check:package": "publint && attw --pack ."
	},
	"peerDependencies": {
		"react": ">=17",
		"vue": ">=3"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/core": "^21.0.1",
		"@eslint/js": "^9.39.5",
		"@types/node": "^25.7.0",
		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0",
		"@vitejs/plugin-vue": "^6.0.10",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-vue": "^10.12.0",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"prettier": "^3.8.3",
		"publint": "^0.3.25",
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.72.1",
		"unplugin-vue": "^7.2.0",
		"vitest": "^5.1.0",
		"vue": "^3.0.0",
		"vue-tsc": "^3.3.14"
	},
	"keywords": [
		"social",
		"share",
		"react",
		"vue",
		"typescript"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DannyelPina/social-share-toolkit.git"
	},
	"homepage": "https://github.com/DannyelPina/social-share-toolkit#readme",
	"bugs": {
		"url": "https://github.com/DannyelPina/social-share-toolkit/issues"
	},
	"sideEffects": false,
	"type": "commonjs",
	"engines": {
		"node": ">=16"
	}
}
